# ==========================================
# QUDO 환경변수 템플릿 (Ubuntu / Oracle Cloud 같은 호스트 배포용)
# 사용법: cp .env.example .env 후 값 교체
#
# 네트워크 전략:
#   - API 컨테이너와 DB/Redis 컨테이너가 같은 docker network(qudo-net)에 있으므로
#     API는 호스트명 대신 컨테이너명으로 접근합니다.
#   - 호스트에서 직접 접근할 때는 127.0.0.1 + 외부 포트(5433/6380) 사용.
# ==========================================

# ---- Docker 이미지 (GHCR) ----
# GitHub Actions이 빌드해서 GHCR에 push → 서버는 이 경로에서 pull
# GitHub 계정(또는 조직)명을 소문자로 ${{ github.repository_owner }}
DOCKER_IMAGE=ghcr.io/<your-github-username>/qudo-api:latest

# ---- App ----
NODE_ENV=production
PORT=8080
TZ=Asia/Seoul

# ---- DB 스키마 동기화 ----
# 첫 배포에선 true (TypeORM이 엔티티 보고 테이블 자동 생성)
# 운영 안정화 후 false 로 바꾸고 마이그레이션 생성/적용으로 전환 권장
DB_SYNCHRONIZE=true

# ---- PostgreSQL (API 컨테이너 내부에서 본 값) ----
POSTGRES_HOST=qudo-postgres
POSTGRES_PORT=5432
POSTGRES_DB=qudo
POSTGRES_USER=qudo
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgres://qudo:change-me-strong@qudo-postgres:5432/qudo

# ---- Redis ----
REDIS_HOST=qudo-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong
REDIS_URL=redis://:change-me-strong@qudo-redis:6379

# ---- Cloudflare R2 (S3 호환) ----
# CF 대시보드 > R2 > Overview 의 Account ID 확인
# CF 대시보드 > R2 > Manage API Tokens 에서 Access Key 발급
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=qudo-assets
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
S3_FORCE_PATH_STYLE=true
# (선택) 공개 액세스 URL: R2 > 버킷 > Settings > Public Access 에서 설정
# 또는 커스텀 도메인: R2 > 버킷 > Settings > Custom Domains
S3_PUBLIC_URL=https://cdn.yourdomain.com

# ---- JWT ----
JWT_ACCESS_SECRET=generate-strong-secret
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== OAuth — id_token JWKS 검증 (Kakao/Google) =====
# Kakao OIDC id_token 의 aud 검증용. **필수** — Kakao Developers > 앱 키 > REST API 키.
# 사전 작업: 카카오 콘솔 > 카카오 로그인 > OpenID Connect 활성화 ON 필수.
# 모바일 SDK 호출 시 scopes:['openid','profile_nickname','profile_image','account_email'] 추가.
KAKAO_CLIENT_ID=

# Google id_token aud 검증용. **필수** — 모바일/웹 client_id 가 다를 수 있으므로 콤마(,) 구분 다중 허용.
# 예: GOOGLE_CLIENT_IDS=123-ios.apps.googleusercontent.com,456-android.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=

# ===== OAuth — Naver (OIDC 미지원으로 access_token + nid/me 흐름 유지) =====
# 백엔드 검증 로직은 nid/me 호출에 access_token Bearer 만 사용. 아래 client_id/secret 는 미사용.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# ===== OAuth revoke (회원탈뼈 시 provider 측 unlink) =====
# Kakao Admin Key. Kakao Developers > 앱 키 > Admin 키. 미설정 시 Kakao unlink skip + 로그.
# Naver/Google 은 access_token/refresh_token 영구 보관 안 하므로 revoke 자체 미지원 (best-effort skip).
KAKAO_ADMIN_KEY=
